    "description": "The codebase of Saba slot games.",
    "main": "src/index.js",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "test-board": "node --es-module-specifier-resolution=node  tests/run.js",
        "reg": "npm set registry https://npm.lumigame.com",
        "pub": "npm publish --registry https://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry https://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release",
        "prepare": "husky",
        "commitlint": "commitlint --edit"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-slot-game-base.git"
    },
    "keywords": [
        "game-base",
        "slot-game",
        "sc-slot-game-base"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "type": "module",
    "license": "ISC",
    "overrides": {
        "mongoose": "6.13.8",
        "mongoose-long": "0.8.0"
    },
    "dependencies": {
        "chance": "^1.1.9",
        "lodash": "^4.17.21",
        "sc-game-base": "5.5.1-beta.15",
        "sc-game-management-client": "0.1.3"
    },
    "resolutions": {
        "sc-game-management-client": "0.1.3"
    },
    "devDependencies": {
        "@babel/preset-env": "7.12.11",
        "@commitlint/cli": "19.8.1",
